msgid "Routes"
msgstr "Routen"

#: didact/web/pages/reference.py
msgid "Rules"
msgstr "Regeln"

#: didact/web/pages/reference.py
msgid "Rules text"
msgstr "Regeltext"

#: didact/web/pages/reference.py
