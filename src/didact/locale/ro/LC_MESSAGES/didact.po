msgstr "Aruncă pe o listă a oracolului: o intrare sau un rând gol (alegi tu unul)"

#: didact/web/pages/drafts.py
msgid "Roll the rest"
msgstr "Aruncă pentru rest"

#: didact/web/pages/records.py
msgid "Roll what the sheet rolls (--fill)"
msgstr "Aruncă ce aruncă foaia (--fill)"

#: didact/web/pages/drafts.py
msgid "Rolls"
